# BitBolt E-Commerce Environment Variables
# Copy this file to .env.local and fill in your values

# ===== Product API =====
# API base URL for fetching products
# Default: https://api.escuelajs.co/api/v1
# Options:
#   - https://api.escuelajs.co/api/v1 (recommended - stable, no auth)
#   - https://fakestoreapi.com (alternative)
VITE_API_BASE_URL=https://api.escuelajs.co/api/v1

# Enable fallback to local products.js when API fails
# Default: true
VITE_ENABLE_FALLBACK=true

# ===== Telegram Checkout =====
# Your Telegram bot token (from @BotFather on Telegram)
# Get it here: https://t.me/botfather
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (where orders will be sent)
# Get your chat ID: https://t.me/userinfobot
VITE_TELEGRAM_CHAT_ID=your_chat_id_here
